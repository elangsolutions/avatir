generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  AGENT
  CLIENT
}

enum AgreementStatus {
  draft
  active
  paused
  closed
}

model User {
  id                String      @id @default(cuid())
  name              String
  email             String      @unique
  passwordHash      String
  role              UserRole    @default(CLIENT)
  avatarUrl         String?
  emailVerifiedAt   DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  agreements        Agreement[] @relation("AgreementClient")
  sourcedAgreements Agreement[] @relation("AgreementAgent")
  authTokens        AuthToken[]
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model Agreement {
  id          String           @id @default(cuid())
  title       String
  clientName  String
  amount      Decimal          @db.Decimal(12, 2)
  currency    String           @default("USD")
  status      AgreementStatus  @default(draft)
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  ownerId     String?
  owner       User?            @relation("AgreementClient", fields: [ownerId], references: [id], onDelete: SetNull)
  agentId     String?
  agent       User?            @relation("AgreementAgent", fields: [agentId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}
