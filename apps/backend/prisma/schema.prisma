generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  AGENT
  CLIENT
}

enum AgreementStatus {
  draft
  active
  paused
  closed
}

model User {
  id                String      @id @default(cuid())
  name              String
  email             String      @unique
  passwordHash      String
  role              UserRole    @default(CLIENT)
  avatarUrl         String?
  emailVerifiedAt   DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  agreements        Agreement[] @relation("AgreementClient")
  sourcedAgreements Agreement[] @relation("AgreementAgent")
  authTokens        AuthToken[]
  integrationClients IntegrationClient[] @relation("IntegrationClientAgent")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PolicyKind {
  OFERTA
  ADJUDICACION
}

enum PolicyFormat {
  ELECTRONICA
  ELECTRONICA_CERTIFICADA
  FISICA
}

enum PolicyRequestStatus {
  received
  under_review
  issued
  rejected
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model Agreement {
  id          String           @id @default(cuid())
  title       String
  clientName  String
  amount      Decimal          @db.Decimal(14, 2)
  currency    String           @default("USD")
  status      AgreementStatus  @default(draft)
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  ownerId     String?
  owner       User?            @relation("AgreementClient", fields: [ownerId], references: [id], onDelete: SetNull)
  agentId     String?
  agent       User?            @relation("AgreementAgent", fields: [agentId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  policyRequest PolicyRequest?
}

/// Machine-to-machine credential used by brokers to submit policy requests.
model IntegrationClient {
  id             String          @id @default(cuid())
  name           String
  keyPrefix      String          @unique
  keyHash        String
  scopes         String[]
  agentId        String?
  agent          User?           @relation("IntegrationClientAgent", fields: [agentId], references: [id], onDelete: SetNull)
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  policyRequests PolicyRequest[]
}

/// A "pedido de poliza": the surety bond request that backs an Agreement.
model PolicyRequest {
  id                  String              @id @default(cuid())
  agreementId         String              @unique
  agreement           Agreement           @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  integrationClientId String
  integrationClient   IntegrationClient   @relation(fields: [integrationClientId], references: [id], onDelete: Cascade)
  idempotencyKey      String
  status              PolicyRequestStatus @default(received)
  policyKind          PolicyKind
  policyFormat        PolicyFormat
  policyAmount        Decimal             @db.Decimal(14, 2)
  currency            String              @default("ARS")
  applicantName       String
  applicantTaxId      String
  applicantAddress    String?
  beneficiaryName     String
  beneficiaryTaxId    String
  beneficiaryAddress  String?
  processCode         String
  fileNumber          String?
  bidOpeningAt        DateTime?
  purpose             String
  purchaseOrder       String?
  billingPeriod       String?
  payload             Json
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([integrationClientId, idempotencyKey])
  @@index([processCode])
  @@index([applicantTaxId])
}
